# ---------------------------------------------------------------
# Auth / Profile / Fitness server (Node + Express + Prisma)  —  .env
# Copy to ".env" and fill in YOUR values. Never commit the real .env.
# ---------------------------------------------------------------

PORT=3000
NODE_ENV=development

# Supabase Postgres — SESSION POOLER string, with the pgbouncer flags.
# Supabase > Project Settings > Database > Connection string > Session pooler
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres?pgbouncer=true&connection_limit=1

# JWT — MUST be byte-for-byte identical to SECRET_KEY in Backend/.env.
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
JWT_SECRET=<paste-generated-secret>
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=172800

# Google Cloud > APIs & Services > Credentials > OAuth 2.0 Client ID (Web application)
GOOGLE_CLIENT_ID=<client-id>.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=<client-secret>
# Must match an "Authorised redirect URI" on that client EXACTLY.
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# Where to send the browser after a successful Google sign-in.
# Must match an "Authorised JavaScript origin" on that client.
FRONTEND_URL=http://localhost:5173

# Reserved for at-rest encryption of stored Google tokens. Currently read
# but unused. Set it anyway so the app keeps working if that lands.
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ENCRYPTION_KEY=<paste-generated-secret>
